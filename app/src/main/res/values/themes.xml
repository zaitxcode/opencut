<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window background doubles as the launch screen: the OpenCut lockup is
      visible until Compose draws its first opaque frame.
    -->
    <style name="Theme.OpenCut" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/brand_accent</item>
    </style>
</resources>
